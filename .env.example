# amikom-ai-free-gateway configuration
# Copy to `.env` and load it yourself, e.g.:
#   set -a; source .env; set +a; npm start
# Or export the variables in your shell.

# --- Gateway ---
HOST=127.0.0.1
PORT=8787

# Optional shared secret clients must send as `Authorization: Bearer <key>`.
# Leave empty to disable auth (keep the gateway on localhost in that case).
# AMIKOM_GATEWAY_KEY=

# --- Upstream ---
AMIKOM_BASE_URL=https://ai.amikom.ac.id/agentic_backend
AMIKOM_DEFAULT_TEAM=miko
# Comma separated list of teams exposed via /v1/models and accepted as model ids.
AMIKOM_TEAMS=miko

# --- Behaviour ---
# derive | random | header
AMIKOM_SESSION_STRATEGY=derive
# last | full
AMIKOM_CONTEXT_MODE=last
# Prompt-based tool calling (EXPERIMENTAL): auto | shim | off
#   auto = enable when the request contains OpenAI `tools` (default)
AMIKOM_TOOL_MODE=auto
# Upstream request timeout (ms)
AMIKOM_TIMEOUT_MS=180000
# SSE keep-alive comment interval (ms), 0 to disable
AMIKOM_KEEPALIVE_MS=15000
